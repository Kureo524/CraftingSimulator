/* Mise en page du HUD de l'atelier (les composants sont dans Theme.uss). */

.hud-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.world-overlay, .tooltip-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* Objectifs */
.hud-top-left { position: absolute; left: 12px; top: 12px; width: 320px; }
.hud-objectives { padding: 14px 16px; }
.hud-objectives > .row { margin-bottom: 8px; }
.objective { padding: 8px 10px; margin-bottom: 4px; border-radius: 12px; transition-property: background-color; transition-duration: 0.12s; }
.objective:hover { background-color: var(--hover); }
.objective .gauge { margin: 6px 0 2px 0; }
.objective-hint { margin-top: 8px; }
.goal { padding: 10px 12px; margin-bottom: 10px; border-radius: 14px; background-color: rgba(16, 20, 32, 0.45); border-width: 1px; border-color: var(--border); }
.goal__name { margin-bottom: 2px; }
.goal__numbers { align-items: flex-end; }
.goal .gauge { margin: 4px 0 4px 0; }
.milestones { margin-bottom: 2px; }
.milestones .objective { padding: 5px 8px; }
.milestones .mono { margin-left: 6px; }

/* ---------- Tutoriel : scénarios ---------- */
/* Carte de quête (haut-gauche) */
.quest { margin-top: 0; padding: 12px 14px 10px 16px; border-radius: 18px; transition-property: opacity, translate, border-color; transition-duration: 0.35s; transition-timing-function: ease-out-cubic; }
.quest--enter { opacity: 0; translate: -16px 0; }
.quest__head { align-items: center; margin-bottom: 2px; }
.quest__head .btn--icon { width: 22px; height: 22px; margin-left: 2px; }
.quest__title { -unity-font-definition: url("Fonts/GothicA1-Bold.ttf"); font-size: 17px; color: var(--text); margin-bottom: 8px; }
.quest__task { align-items: center; padding: 8px 10px; border-radius: 12px; border-width: 1px; border-color: rgba(138, 168, 224, 0.28); border-top-color: rgba(138, 168, 224, 0.45); border-left-color: rgba(138, 168, 224, 0.45); background-color: rgba(16, 20, 32, 0.55); transition-property: border-color, background-color; transition-duration: 0.3s; }
.quest__check { width: 16px; height: 16px; border-radius: 5px; border-width: 1.5px; border-color: var(--accent); margin-right: 10px; align-items: center; justify-content: center; transition-property: background-color, border-color, scale; transition-duration: 0.3s; transition-timing-function: ease-out-back; }
.quest__check-mark { font-size: 11px; color: #0e0e13; opacity: 0; padding: 0; margin: 0; -unity-font-definition: url("Fonts/GothicA1-Bold.ttf"); transition-property: opacity; transition-duration: 0.2s; }
.quest__objective { -unity-font-definition: url("Fonts/GothicA1-Bold.ttf"); font-size: 12px; color: var(--text); white-space: normal; }
.quest__counter { color: var(--accent-text); margin-left: 8px; }
.quest__body { margin-top: 10px; font-size: 11px; }
.quest__status { margin-top: 6px; white-space: normal; }
.quest__status--done { color: var(--success); }
.quest__foot { margin-top: 6px; }
.quest--done .quest__task { border-color: rgba(158, 189, 133, 0.45); background-color: var(--success-soft); }
.quest--done .quest__check { background-color: var(--success); border-color: var(--success); scale: 1.15 1.15; }
.quest--done .quest__check-mark { opacity: 1; }
.quest--collapsed .quest__title { margin-bottom: 6px; font-size: 13px; }

/* Rail de constellation (une étoile par étape) */
.rail { align-items: center; margin-top: 10px; }
.rail__star { width: 7px; height: 7px; border-radius: 4px; border-width: 1px; border-color: rgba(232, 238, 250, 0.22); background-color: rgba(0, 0, 0, 0); }
.rail__star--done { background-color: var(--lavender); border-color: var(--lavender); }
.rail__star--current { width: 11px; height: 11px; border-radius: 6px; border-color: var(--accent); border-width: 1.5px; background-color: var(--accent-soft); }
.rail__link { flex-grow: 1; height: 1px; max-width: 22px; min-width: 6px; background-color: rgba(232, 238, 250, 0.1); }
.rail__link--done { background-color: rgba(165, 151, 192, 0.6); }

/* Fenêtre d'annonce (centre) */
.scenario-layer { background-color: rgba(8, 8, 12, 0.45); }
.scenario { width: 540px; padding: 22px 26px 18px 26px; border-radius: 22px; background-color: rgba(22, 22, 30, 0.88); transition-property: opacity, translate, scale; transition-duration: 0.45s; transition-timing-function: ease-out-cubic; }
.scenario--enter { opacity: 0; translate: 0 14px; scale: 0.97 0.97; }
.scenario__kicker { margin-bottom: 6px; }
.scenario__title { -unity-font-definition: url("Fonts/GothicA1-Bold.ttf"); font-size: 22px; color: var(--text); margin-bottom: 2px; }
.scenario .rail { margin: 8px 0 14px 0; }
.scenario__body { font-size: 13px; color: var(--text-2); margin-bottom: 8px; }
.scenario__rule { align-items: flex-start; padding: 10px 12px; margin-top: 6px; border-radius: 12px; border-width: 1px; border-color: rgba(138, 168, 224, 0.28); border-top-color: rgba(138, 168, 224, 0.45); border-left-color: rgba(138, 168, 224, 0.45); background-color: rgba(16, 20, 32, 0.55); }
.scenario__rule-n { width: 28px; color: var(--lavender); margin-top: -6px; }
.scenario__reward { margin-top: 12px; }
.scenario__actions { margin-top: 16px; align-items: center; }

/* Fil vers la cible */
.guide__tag { position: absolute; translate: 0 -50%; padding: 3px 10px; border-radius: 10px; background-color: rgba(16, 20, 32, 0.82); border-width: 1px; border-color: rgba(138, 168, 224, 0.35); white-space: nowrap; }
.guide__tag--left { translate: -100% -50%; }
.guide__tag--above { translate: -50% -100%; }
.scenario__rule > Label { flex-shrink: 1; }

/* Contrôles */
.hud-top-right { position: absolute; right: 12px; top: 12px; flex-direction: row; align-items: center; }
.hud-top-right > * { margin-left: 8px; }
.clock { height: 34px; padding: 0 12px; justify-content: center; border-radius: 14px; }
.compass { width: 48px; height: 48px; border-radius: 24px; }
.compass__label { position: absolute; width: 14px; height: 16px; color: var(--text-3); -unity-font-definition: url("Fonts/GothicA1-Bold.ttf"); font-size: 10px; -unity-text-align: middle-center; padding: 0; margin: 0; }
.compass__label--north { color: var(--lavender); font-size: 12px; }

/* Messages */
.toasts { position: absolute; top: 60px; left: 30%; right: 30%; align-items: center; }
.toast { max-width: 520px; }

/* Inspecteur */
.hud-inspector { position: absolute; right: 12px; top: 58px; bottom: 132px; width: 400px; padding: 12px; }
.inspector__header { padding: 12px 14px; margin-bottom: 10px; border-radius: 18px; }
.inspector__desc { margin-top: 8px; }
.inspector__actions { margin-top: 10px; }
.inspector__actions > .btn { margin-left: 6px; }
.inspector__tabs { margin-bottom: 10px; align-self: flex-start; }
.inspector__subtabs { margin-bottom: 10px; align-self: flex-start; }
.inspector__scroll { flex-grow: 1; }
.inspector__field { margin-top: 8px; }
.inspector__slider { margin: 6px 0; }
.gauge--inline { margin: 3px 0 0 0; height: 3px; }

.recipe-line { margin-bottom: 8px; }
.recipe-flow { flex-wrap: wrap; margin-top: 4px; }
.arrow { margin: 0 6px 0 2px; font-size: 14px; }

/* Faces */
.sides-cross { margin-bottom: 12px; }
.sides-row { justify-content: center; align-items: center; margin-bottom: 6px; }
.sides-cell { width: 118px; height: 104px; margin: 0 3px; padding: 6px; border-radius: 14px; align-items: center; justify-content: center; }
.sides-cell--empty { border-width: 0; background-color: rgba(0, 0, 0, 0); }
.sides-center { justify-content: center; }
.sides-cell .side-mode { width: 100%; margin: 4px 0; }
.side-mode--input { border-color: var(--accent); background-color: var(--accent-soft); }
.side-mode--output { border-color: var(--lavender); background-color: var(--lavender-soft); }
.side-mode--none { color: var(--text-3); }
.side-filter { width: 100%; }
.side-filter .unity-base-popup-field__input { padding: 2px 6px; font-size: 11px; }
.side-filter .unity-base-popup-field__text { overflow: hidden; text-overflow: ellipsis; }
.side-neighbour { -unity-text-align: middle-center; white-space: normal; }
.side-warning { color: var(--warning); }

/* Établi */
.craft-card { padding: 10px 12px; }
.craft-card--disabled { opacity: 0.75; }
.craft-actions { margin-top: 6px; }

/* Journal */
.hud-log { position: absolute; right: 12px; bottom: 120px; width: 400px; }
.log-line { margin-top: 3px; }
.log-text { font-size: 10px; color: var(--text-2); -unity-text-align: upper-right; }

/* Barre d'inventaire */
.hud-bottom { position: absolute; left: 12px; right: 12px; bottom: 12px; align-items: center; }
.mode-hint { margin-bottom: 8px; padding: 4px 12px; border-radius: 12px; background-color: rgba(16, 20, 32, 0.75); }
.hotbar { flex-direction: column; padding: 8px 10px; max-width: 100%; border-radius: 22px; }
.hotbar__filter { align-self: center; margin-bottom: 6px; }
.hotbar__scroll { max-width: 1100px; height: 60px; }
.slot .ricon { left: 7px; top: 7px; right: 7px; bottom: 7px; }
.hotbar__scroll .unity-scroll-view__content-container { flex-direction: row; }
.hotbar__empty { margin: 20px; }
.slot {
    width: 56px; height: 56px; margin: 0 3px; padding: 0;
    border-radius: 12px; border-width: 1px;
    border-color: var(--border); border-top-color: var(--rim); border-left-color: var(--rim);
    background-color: var(--surface-raised);
    transition-property: border-color, background-color, translate; transition-duration: 0.15s;
}
.slot:hover { border-color: var(--border-strong); background-color: rgba(232, 238, 250, 0.11); }
.slot--placeable:hover { translate: 0 -2px; }
.slot--active { border-color: var(--accent); background-color: var(--accent-soft); }
.slot__swatch { position: absolute; left: 7px; top: 8px; width: 12px; height: 12px; }
.slot__count { position: absolute; right: 8px; top: 2px; }
.slot__name { position: absolute; left: 7px; right: 6px; bottom: 5px; white-space: normal; -unity-text-align: lower-left; }

/* Livre de recettes */
.modal-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(8, 8, 12, 0.72); align-items: center; justify-content: center; }
.book__left { width: 300px; padding: 14px; margin-right: 12px; border-radius: 22px; background-color: var(--glass); }
.book__search { margin: 10px 0 8px 0; }
.book__filter { margin-bottom: 8px; flex-wrap: wrap; }
.book__filter .segmented__item { padding: 0 7px; font-size: 11px; }
.book__right { flex-grow: 1; }
.book__header { padding: 14px 16px; margin-bottom: 12px; }
.book__header .btn--icon { margin-right: 8px; }
.book__desc { margin-top: 8px; }
.book__tabs { align-self: flex-start; margin-bottom: 12px; }
.recipe-card { padding: 12px 14px; }
.machine-chip { margin-right: 8px; }

/* Indicateurs au-dessus des machines */
.status-dot { position: absolute; width: 12px; height: 12px; border-radius: 6px; translate: -50% -50%; border-width: 2px; border-color: rgba(12, 12, 18, 0.9); }
.status-dot--warning { background-color: var(--warning); }
.status-dot--danger { background-color: var(--danger); }

/* ---------- Couches ---------- */
.layer-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.cutaway-hint { position: absolute; bottom: 150px; left: 30%; right: 30%; -unity-text-align: middle-center; padding: 4px 12px; border-radius: 12px; background-color: rgba(16, 20, 32, 0.7); }
.hotbar__top { justify-content: center; margin-bottom: 6px; }
.hotbar__top .hotbar__filter { margin: 0 0 0 10px; }

/* ---------- Menu contextuel ---------- */
.context-menu { position: absolute; translate: -50% -100%; width: 210px; padding: 8px; }
.context-menu__head { margin-bottom: 6px; padding-left: 4px; }
.context-menu__item { width: 100%; margin-top: 4px; -unity-text-align: middle-left; }

/* ---------- Machine (comme un four) ---------- */
.machine-layout { align-items: flex-start; justify-content: center; }
.machine-col { align-items: center; margin: 0 6px; }
.machine-col__title { margin-bottom: 6px; }
.machine-slots { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.machine-progress { width: 64px; align-items: center; margin-top: 46px; }
.machine-progress__arrow { font-size: 22px; color: var(--text-3); }
.machine-progress .gauge { width: 56px; }

/* Case d'objet */
.islot-wrap, .vault-cell { width: 64px; align-items: center; margin: 0 3px 8px 3px; }
.islot { width: 52px; height: 52px; border-radius: 10px; border-width: 1px; border-color: var(--border-strong); border-top-color: var(--rim); border-left-color: var(--rim); background-color: var(--input); overflow: hidden; transition-property: border-color; transition-duration: 0.12s; }
.islot:hover { border-color: var(--accent); }
.islot--empty { border-color: var(--border); background-color: rgba(10, 10, 15, 0.4); }
.islot__fill { position: absolute; left: 6px; top: 6px; right: 6px; bottom: 6px; border-radius: 6px; }
.islot__count { position: absolute; right: 5px; bottom: 1px; }
.islot__name { margin-top: 3px; -unity-text-align: upper-center; white-space: normal; max-width: 64px; }
.islot-grid { flex-direction: row; flex-wrap: wrap; }

/* Réservoirs : liquide (cuve pleine), gaz (capsule à bulles), énergie (barre fine) */
.tank-wrap { width: 70px; align-items: center; margin: 0 3px 6px 3px; }
.tank { width: 38px; height: 104px; border-width: 1px; border-color: var(--border-strong); border-top-color: var(--rim); border-left-color: var(--rim); background-color: var(--input); overflow: hidden; justify-content: flex-end; }
.tank__fill { width: 100%; height: 0; transition-property: height; transition-duration: 0.3s; }
.tank--fluid { border-radius: 8px; }
.tank__surface { height: 3px; background-color: rgba(255, 255, 255, 0.35); }
.tank--gas { border-radius: 19px; border-color: rgba(232, 238, 250, 0.22); }
.tank__bubbles { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-repeat: repeat repeat; background-size: 32px 32px; -unity-background-image-tint-color: rgba(255, 255, 255, 0.9); }
.tank--energy { width: 16px; border-radius: 8px; }
.tank--energy .tank__fill { background-color: var(--accent); }
.tank__fill--empty { background-color: rgba(0, 0, 0, 0); }
.tank__name { margin-top: 4px; -unity-text-align: upper-center; white-space: normal; max-width: 70px; }
.tank__amount { font-size: 10px; color: var(--text-2); }
.tank__kind { font-size: 9px; color: var(--text-3); }
.tank__dump { margin-top: 2px; height: 18px; font-size: 10px; }

.sides-cell--vertical { border-color: rgba(165, 151, 192, 0.3); }

/* ---------- Icônes de ressources (à la JEI) ---------- */
.ricon { position: absolute; left: 3px; top: 3px; right: 3px; bottom: 3px; }
.rslot { width: 44px; height: 44px; margin: 0 4px 4px 0; border-radius: 8px; border-width: 1px; border-color: var(--border); border-top-color: var(--rim); border-left-color: var(--rim); background-color: rgba(10, 10, 15, 0.55); transition-property: border-color, background-color, scale; transition-duration: 0.1s; }
.rslot:hover { border-color: var(--accent); background-color: var(--accent-soft); }
.rslot__count { position: absolute; right: 3px; bottom: 0; padding: 0; margin: 0; font-size: 11px; -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf"); color: var(--text); text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9); }
.rslot--empty { background-color: rgba(10, 10, 15, 0.3); border-color: rgba(232, 238, 250, 0.05); }
.rslot--empty:hover { border-color: rgba(232, 238, 250, 0.05); background-color: rgba(10, 10, 15, 0.3); }
.rslot--inv { width: 52px; height: 52px; margin: 0 6px 6px 0; }
.rslot--inv .ricon { left: 6px; top: 6px; right: 6px; bottom: 6px; }
.rslot--catalog { width: 40px; height: 40px; margin: 0 3px 3px 0; }
.rslot--vault { width: 48px; height: 48px; margin: 0 6px 6px 0; }
.rslot--hero { width: 56px; height: 56px; margin: 0 12px 0 0; }
.rslot--small { width: 28px; height: 28px; margin: 0 8px 0 0; border-radius: 6px; }
.rslot--small .ricon { left: 2px; top: 2px; right: 2px; bottom: 2px; }
.rslot--focus { border-color: var(--success); }
.rslot--missing { border-color: rgba(224, 96, 106, 0.6); }
.chip #chip-icon { position: relative; left: 0; top: 0; width: 16px; height: 16px; margin-right: 6px; }

/* ---------- Inventaire (centre) + catalogue (bord droit) ---------- */
.modal-layer--with-catalog { padding-right: 384px; }
.inventory { width: 570px; padding: 16px 16px 12px 18px; border-radius: 24px; background-color: rgba(22, 22, 30, 0.9); }
.inventory__filter { align-self: flex-start; margin: 10px 0 12px 0; }
.inventory__grid { flex-direction: row; flex-wrap: wrap; }
.inventory__hint { margin-top: 6px; }
.catalog { position: absolute; right: 0; top: 0; bottom: 0; width: 372px; padding: 16px 12px 12px 16px; border-top-right-radius: 0; border-bottom-right-radius: 0; border-right-width: 0; background-color: rgba(22, 22, 30, 0.94); }
.catalog-grid { flex-direction: row; flex-wrap: wrap; }
.catalog__legend { margin-top: 8px; padding-top: 8px; border-top-width: 1px; border-color: var(--border); flex-direction: row; flex-wrap: wrap; }
.catalog__legend-row { margin-right: 12px; align-items: center; }
.catalog__legend-row .ricon { position: relative; left: 0; top: 0; width: 18px; height: 18px; margin-right: 6px; }
.catalog__keys { margin-top: 6px; white-space: normal; }

/* Livre : fiche au centre, ingrédients en icônes */
.book { width: 760px; height: 86%; flex-direction: column; }
.recipe-flow { align-items: flex-start; }
.recipe-ingredient { align-items: center; margin-right: 4px; min-width: 48px; }
.recipe-ingredient .rslot { margin: 0; }
.recipe-ingredient__amount { font-size: 10px; color: var(--text-2); margin-top: 2px; }
.recipe-ingredient__amount--missing { color: var(--danger); }
.recipe-arrow { margin: 12px 10px 0 6px; font-size: 18px; }
.machine-chip { align-items: center; }

/* ---------- Établi ---------- */
.workbench { width: 78%; height: 80%; max-width: 1000px; padding: 16px; background-color: rgba(22, 22, 30, 0.86); }
.workbench__desc { margin: 4px 0 10px 0; }
.workbench__bar { margin-bottom: 10px; }
.workbench__grid { flex-direction: row; flex-wrap: wrap; }
.workbench__grid .craft-card { width: 300px; margin: 0 10px 10px 0; }
.workbench__toggle .unity-toggle__checkmark { border-radius: 4px; background-color: var(--input); border-color: var(--border-strong); }
.workbench__toggle Label { color: var(--text-2); }

/* ---------- Options ---------- */
.options { width: 640px; max-height: 86%; padding: 16px; background-color: rgba(22, 22, 30, 0.88); }
.options__scroll { max-height: 420px; }
.options__row { min-height: 30px; padding: 2px 4px; }
.options__key { min-width: 150px; }
.options__actions { margin-top: 4px; }

/* ---------- Écran machine + inventaire ---------- */
.inventory-column { height: 100%; justify-content: center; align-items: center; padding: 14px 0; }
.machine-panel { width: 570px; flex-shrink: 1; min-height: 160px; max-height: 64%; padding: 12px; margin-bottom: 10px; border-radius: 24px; background-color: rgba(22, 22, 30, 0.9); }
.machine-panel .inspector__scroll { flex-grow: 1; flex-shrink: 1; min-height: 60px; }
.inventory { flex-shrink: 0; }
.inventory-layer--machine .inventory__filter { display: none; }
.inventory-layer--machine .inventory .sheet-title { font-size: 13px; }
.inspector__drop-hint { margin-top: 4px; }
.rslot--canister .ricon { left: 4px; top: 3px; right: 4px; bottom: 3px; }
.drag-ghost { position: absolute; width: 44px; height: 44px; opacity: 0.92; }
.craft-card--focus { border-color: var(--accent); background-color: var(--accent-soft); }

/* Vault : quantité à prendre */
.rslot--picked { border-color: var(--accent); background-color: var(--accent-soft); }
.vault-picker { margin-top: 8px; padding: 10px 12px; border-radius: 14px; border-width: 1px; border-color: rgba(138, 168, 224, 0.28); border-top-color: rgba(138, 168, 224, 0.45); border-left-color: rgba(138, 168, 224, 0.45); background-color: rgba(16, 20, 32, 0.55); }
.vault-picker__head { align-items: center; margin-bottom: 8px; }
.vault-picker__icon { position: relative; left: 0; top: 0; width: 32px; height: 32px; margin-right: 10px; }
.vault-picker__row { align-items: center; flex-wrap: wrap; }
.vault-picker__btn { margin-right: 4px; min-width: 44px; }
.vault-picker__field { width: 70px; margin: 0 4px 0 6px; }

/* Faces : les cases s'adaptent à leur contenu (le bouton ne rétrécit plus) */
.sides-cell { height: auto; min-height: 104px; width: 140px; }
.sides-cell > * { flex-shrink: 0; }
.sides-cell .side-mode { min-height: 24px; }

/* Tutoriel au-dessus des panneaux */
#tutorial-layer .quest { position: absolute; left: 12px; top: 12px; width: 320px; }
.quest--compact .quest__body, .quest--compact .rail, .quest--compact .quest__foot { display: none; }

/* ---------- Liste déroulante de la DA ---------- */
.gdrop { flex-direction: row; align-items: center; min-height: 26px; padding: 2px 8px 2px 10px; border-radius: 10px; border-width: 1px; border-color: var(--border); border-top-color: var(--rim); border-left-color: var(--rim); background-color: var(--input); transition-property: border-color; transition-duration: 0.12s; }
.gdrop:hover { border-color: var(--border-strong); }
.gdrop--open { border-color: var(--accent); }
.gdrop__icon { position: relative; left: 0; top: 0; width: 16px; height: 16px; margin-right: 6px; flex-shrink: 0; }
.gdrop__label { flex-grow: 1; flex-shrink: 1; font-size: 11px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0; margin: 0; }
.gdrop__chevron { font-size: 10px; color: var(--text-3); margin-left: 4px; padding: 0; }
.gdrop__catcher { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.gdrop__menu { position: absolute; max-height: 340px; padding: 4px; border-radius: 12px; border-width: 1px; border-color: var(--border-strong); border-top-color: var(--rim); border-left-color: var(--rim); background-color: rgba(23, 23, 30, 0.97); }
.gdrop__scroll { max-height: 330px; }
.gdrop__item { min-height: 28px; padding: 3px 10px 3px 6px; border-radius: 8px; align-items: center; }
.gdrop__item:hover { background-color: var(--accent-soft); }
.gdrop__item--active .gdrop__item-label { color: var(--accent-text); }
.gdrop__check { width: 16px; color: var(--accent); font-size: 11px; padding: 0; margin: 0; }
.gdrop__item-icon { position: relative; left: 0; top: 0; width: 20px; height: 20px; margin-right: 8px; flex-shrink: 0; }
.gdrop__item-label { font-size: 12px; color: var(--text); white-space: nowrap; padding: 0; margin: 0; }
.sides-cell .side-filter { width: 100%; }

/* ---------- Filtre d'affichage (bas-gauche) ---------- */
.view-filter { position: absolute; left: 12px; bottom: 12px; flex-direction: row; align-items: center; padding: 6px; border-radius: 16px; }
.view-filter__toggle { margin: 0; }
.view-filter--active .view-filter__toggle { border-color: var(--accent); background-color: var(--accent-soft); }
.view-filter__body { align-items: center; margin-left: 8px; }
.view-filter__label { margin: 0 4px 0 4px; }
.view-filter__dropdown { width: 160px; }
.view-filter__count { margin: 0 2px 0 6px; font-size: 10px; color: var(--text-3); }

/* ---------- Tutoriel : lisibilité ---------- */
#tutorial-layer .quest { width: 360px; background-color: rgba(18, 18, 26, 0.94); }
.quest__body { font-size: 13px; color: var(--text); white-space: normal; margin-top: 12px; }
.quest__objective { font-size: 13px; }
.quest__status { font-size: 11px; }
.scenario { background-color: rgba(18, 18, 26, 0.96); }
.scenario__body { font-size: 14px; color: var(--text); }
.scenario__rule .text-2 { font-size: 13px; color: var(--text); }
.guide__tag { font-size: 12px; color: var(--text); background-color: rgba(14, 16, 26, 0.95); padding: 5px 12px; }

/* ---------- Barre rapide (9 emplacements) ---------- */
.hotbar__slots { justify-content: center; }
.hotbar-slot { width: 52px; height: 52px; }
.hotbar-slot .ricon { left: 7px; top: 8px; right: 7px; bottom: 6px; }
.hotbar-slot__key { position: absolute; left: 4px; top: 1px; padding: 0; margin: 0; font-size: 9px; color: var(--text-3); -unity-font-definition: url("Fonts/IBMPlexMono-Regular.ttf"); }
.hotbar-slot.slot--active { border-color: var(--accent); border-width: 2px; background-color: var(--accent-soft); translate: 0 -3px; }
.hotbar-slot.slot--active .hotbar-slot__key { color: var(--accent-text); }
.hotbar-slot--empty { background-color: rgba(10, 10, 15, 0.35); }
.hotbar-slot--out .ricon { opacity: 0.35; }
.inventory__bar-title { margin: 6px 0 4px 0; }
.inventory__hotbar { padding-top: 6px; border-top-width: 1px; border-color: var(--border); }
.inventory__hotbar .hotbar-slot { margin: 0 6px 6px 0; }

/* ---------- Choix du câble ---------- */
.cable-picker { padding: 8px 10px; align-items: center; border-radius: 18px; margin-bottom: 8px; }
.cable-picker__title { margin-bottom: 6px; }
.cable-picker__option { align-items: center; padding: 5px 12px 5px 8px; margin: 0 3px; border-radius: 12px; border-width: 1px; border-color: var(--border); background-color: var(--surface-raised); transition-property: border-color, background-color; transition-duration: 0.12s; }
.cable-picker__option:hover { border-color: var(--border-strong); }
.cable-picker__option--active { border-color: var(--accent); background-color: var(--accent-soft); }
.cable-picker__icon { position: relative; left: 0; top: 0; width: 20px; height: 20px; margin-right: 6px; }
.cable-picker__hint { margin-top: 6px; }

/* ---------- Panneaux de mode (haut de l'écran) ---------- */
.top-center { position: absolute; top: 12px; left: 0; right: 0; align-items: center; }
.mode-panel { width: 460px; padding: 12px 14px; border-radius: 18px; background-color: rgba(18, 18, 26, 0.94); margin-bottom: 8px; }
.mode-panel--danger { border-color: rgba(224, 96, 106, 0.45); border-top-color: rgba(224, 96, 106, 0.6); border-left-color: rgba(224, 96, 106, 0.6); }
.mode-panel__head { align-items: center; margin-bottom: 8px; }
.mode-panel__line { align-items: center; margin-bottom: 4px; }
.mode-panel__ok { color: var(--success); }
.mode-panel__missing { color: var(--danger); }
.mode-panel__danger { color: var(--danger); }
.mode-panel__label { margin: 2px 0 4px 0; }
.mode-panel__refund { flex-wrap: wrap; margin-bottom: 4px; }
.mode-panel__refund .rslot--small { margin: 0 4px 4px 0; }
.mode-panel__hint { margin-top: 6px; white-space: normal; }
.mode-panel__actions { margin-top: 10px; }

/* Mode suppression : HUD masqué, cadre rouge discret */
.delete-frame { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-width: 2px; border-color: rgba(224, 96, 106, 0.55); display: none; }
.delete-mode .delete-frame { display: flex; }
.delete-mode .hud-top-left, .delete-mode .hud-bottom, .delete-mode #view-filter, .delete-mode #tutorial-layer, .delete-mode .hud-log { display: none; }
