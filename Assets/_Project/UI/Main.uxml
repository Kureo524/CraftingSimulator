<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Theme.uss" />
    <Style src="Game.uss" />
    <ui:VisualElement name="root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="overlay" class="world-overlay" picking-mode="Ignore" />
        <ui:VisualElement name="top-left" class="hud-top-left" picking-mode="Ignore">
            <ui:VisualElement name="objectives" class="glass glass--light hud-objectives" />
            <ui:VisualElement name="tutorial" class="glass hud-tutorial" />
        </ui:VisualElement>
        <ui:VisualElement name="top-right" class="hud-top-right" picking-mode="Ignore" />
        <ui:Label name="cutaway-hint" class="system cutaway-hint hidden" picking-mode="Ignore" />
        <ui:VisualElement name="toasts" class="toasts" picking-mode="Ignore" />
        <ui:VisualElement name="inspector" class="glass glass--light hud-inspector hidden" />
        <ui:VisualElement name="log" class="hud-log" picking-mode="Ignore" />
        <ui:VisualElement name="bottom" class="hud-bottom" picking-mode="Ignore">
            <ui:Label name="mode-hint" class="system mode-hint hidden" picking-mode="Ignore" />
            <ui:VisualElement name="hotbar" class="glass glass--light hotbar" />
        </ui:VisualElement>
        <ui:VisualElement name="context-layer" class="layer-fill" picking-mode="Ignore" />
        <ui:VisualElement name="inventory-layer" class="modal-layer modal-layer--with-catalog hidden">
            <ui:VisualElement name="inventory" class="glass glass--light inventory" />
        </ui:VisualElement>
        <ui:VisualElement name="workbench-layer" class="modal-layer hidden">
            <ui:VisualElement name="workbench" class="glass glass--light workbench" />
        </ui:VisualElement>
        <ui:VisualElement name="book-layer" class="modal-layer modal-layer--with-catalog hidden">
            <ui:VisualElement name="book" class="book" />
        </ui:VisualElement>
        <ui:VisualElement name="catalog" class="glass glass--light catalog hidden" />
        <ui:VisualElement name="options-layer" class="modal-layer hidden">
            <ui:VisualElement name="options" class="glass glass--light options" />
        </ui:VisualElement>
        <ui:VisualElement name="tooltip-layer" class="tooltip-layer" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
